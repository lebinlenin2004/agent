# --- App ---
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string-of-32+chars   # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true            # set false once your advisors have accounts
CORS_ORIGINS=http://localhost:5173 # comma-separated; the React dev server

# --- Database / queue ---
DATABASE_URL=postgresql+psycopg://vacancy:vacancy@localhost:5432/vacancy
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false               # false = FastAPI background tasks (fine for dev)

# --- Research (mock needs no credentials) ---
SEARCH_PROVIDER=mock               # mock | http
SEARCH_API_URL=
SEARCH_API_KEY=
PERMITTED_PORTALS=                 # comma-separated job-portal domains you are allowed to use
USER_AGENT=VacancyResearchBot/1.0 (+mailto:you@example.org)
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
PER_DOMAIN_DELAY_SECONDS=1.0
MAX_PAGES_PER_COMPANY=12
USE_PLAYWRIGHT=false
RECHECK_INTERVAL_HOURS=72

# --- AI ---
LLM_PROVIDER=mock                  # mock | anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
